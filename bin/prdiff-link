#!/usr/bin/env python3
"""Print a Markdown link that opens a side-by-side diff via the PR Diff Links extension.

Usage:
  prdiff-link [--uri | --file DIR] [--text TEXT] REPO BASE HEAD PATH [LINE]

  --uri       vscode://fallenreds.pr-diff-links/open?... link
  --file DIR  write DIR/<path with / -> __>__L<line>.prdiff and link to it via file:// (default)
"""
import argparse
import json
import os
import sys
from urllib.parse import quote, urlencode


def main():
    p = argparse.ArgumentParser()
    mode = p.add_mutually_exclusive_group()
    mode.add_argument("--uri", action="store_true")
    mode.add_argument("--file", metavar="DIR")
    p.add_argument("--text")
    p.add_argument("repo")
    p.add_argument("base")
    p.add_argument("head")
    p.add_argument("path")
    p.add_argument("line", nargs="?", type=int)
    a = p.parse_args()

    spec = {"repo": os.path.abspath(a.repo), "base": a.base, "head": a.head, "path": a.path}
    if a.line:
        spec["line"] = a.line
    text = a.text or (f"{os.path.basename(a.path)}:{a.line}" if a.line else os.path.basename(a.path))

    if a.uri:
        target = "vscode://fallenreds.pr-diff-links/open?" + urlencode({k: str(v) for k, v in spec.items()})
    else:
        out_dir = os.path.abspath(a.file or os.path.join(os.getcwd(), "prdiff"))
        os.makedirs(out_dir, exist_ok=True)
        name = a.path.replace("/", "__") + (f"__L{a.line}" if a.line else "") + ".prdiff"
        fname = os.path.join(out_dir, name)
        with open(fname, "w", encoding="utf-8") as f:
            json.dump(spec, f, ensure_ascii=False)
        target = "file://" + quote(fname)

    sys.stdout.write(f"[{text}]({target})\n")


if __name__ == "__main__":
    main()
