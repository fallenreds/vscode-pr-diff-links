{
  "name": "pr-diff-links",
  "displayName": "PR Diff Links",
  "description": "Open a side-by-side diff of a pull request file from a link (plain .prdiff file path or vscode:// URI).",
  "version": "0.1.0",
  "publisher": "fallenreds",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onUri",
    "onLanguage:prdiff",
    "onStartupFinished"
  ],
  "contributes": {
    "languages": [
      {
        "id": "prdiff",
        "extensions": [
          ".prdiff"
        ],
        "aliases": [
          "PR diff link"
        ]
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fallenreds/vscode-pr-diff-links"
  }
}
