{
  "name": "pr-diff-links",
  "displayName": "PR Diff Links",
  "description": "Open a side-by-side diff of a pull request file from a link (plain .prdiff file path or vscode:// URI) and browse pull requests as a file tree.",
  "version": "0.2.0",
  "publisher": "fallenreds",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./extension.js",
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "activationEvents": [
    "onUri",
    "onLanguage:prdiff",
    "onStartupFinished"
  ],
  "contributes": {
    "languages": [
      {
        "id": "prdiff",
        "extensions": [
          ".prdiff"
        ],
        "aliases": [
          "PR diff link"
        ]
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "prDiffLinks",
          "title": "PR Diff Links",
          "icon": "media/pull-request.svg"
        }
      ]
    },
    "views": {
      "prDiffLinks": [
        {
          "id": "prDiffLinks.tree",
          "name": "Pull Requests"
        }
      ]
    },
    "commands": [
      {
        "command": "prDiffLinks.refresh",
        "title": "Refresh",
        "category": "PR Diff Links",
        "icon": "$(refresh)"
      },
      {
        "command": "prDiffLinks.openOnGitHub",
        "title": "Open on GitHub",
        "category": "PR Diff Links",
        "icon": "$(globe)"
      },
      {
        "command": "prDiffLinks.openFile",
        "title": "Open Diff",
        "category": "PR Diff Links"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "prDiffLinks.openOnGitHub",
          "when": "false"
        },
        {
          "command": "prDiffLinks.openFile",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "prDiffLinks.refresh",
          "when": "view == prDiffLinks.tree",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "prDiffLinks.openOnGitHub",
          "when": "view == prDiffLinks.tree && viewItem =~ /^pr\\b/",
          "group": "inline@2"
        }
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fallenreds/vscode-pr-diff-links"
  }
}
